# Copy to .env and adjust. All variables are optional; defaults run fully offline.

# memory | pgvector
RAG_STORE_BACKEND=memory
RAG_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag

# hashing (offline, deterministic) | sentence-transformers | openai
RAG_EMBEDDING_PROVIDER=hashing
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DIM=384
# Only needed when RAG_EMBEDDING_PROVIDER=openai or RAG_LLM_PROVIDER=openai
RAG_OPENAI_API_KEY=

# Second-stage reranking: none | term-overlap (offline) | cross-encoder (needs .[local-embeddings])
RAG_RERANKER=none
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RERANK_CANDIDATES=20

# Answer generation: fake (offline, extractive) | openai (needs RAG_OPENAI_API_KEY and .[openai])
RAG_LLM_PROVIDER=fake
RAG_LLM_MODEL=gpt-4o-mini
RAG_LLM_TEMPERATURE=0.0

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MAX_UPLOAD_MB=10

# Used by docker-compose for the Postgres container
POSTGRES_PASSWORD=postgres

# Logging
RAG_LOG_LEVEL=INFO
RAG_JSON_LOGS=true
